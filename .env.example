# Aplikasi ini memakai pola BYOK: kunci dimasukkan lewat menu 👨‍👩‍👧 di dalam
# aplikasi dan hanya disimpan di perangkat. File ini OPSIONAL — pakai hanya
# bila Anda ingin satu kunci tetap untuk semua pengguna di komputer ini.
#
# Ambil kunci gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model cadangan bila pengguna belum memilih di aplikasi.
# Daftar model sebenarnya diambil langsung dari kunci Anda saat runtime.
GEMINI_MODEL=gemini-2.5-flash

PORT=8787
